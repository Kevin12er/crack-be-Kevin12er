generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  INSTRUCTOR
  STUDENT
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  name             String?
  password         String
  role             Role          @default(STUDENT)
  emailVerified    Boolean       @default(false)
  emailVerifyToken String?       @unique
  emailVerifyExpiresAt  DateTime?
  courses          Course[]
  enrollment       Enrollment[]
  quizAttempts     QuizAttempt[]
  results          Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String?      @db.Text
  price        Float        @default(0)
  instructorId String
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  enrollment   Enrollment[]
  materials    Material[]
  quizzes      Quiz[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Quiz {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  description String?        @db.Text
  timeLimit   Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]
  questions   QuizQuestion[]
  results     Result[]

  @@index([courseId])
}

model QuizQuestion {
  id        String       @id @default(uuid())
  quizId    String
  question  String       @db.Text
  type      QuestionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuizOption[]
  answers   QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  optionText String       @db.Text
  isCorrect  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id          String            @id @default(uuid())
  quizId      String
  studentId   String
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  score       Float?
  status      QuizAttemptStatus @default(IN_PROGRESS)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  quiz        Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]
  result      Result?

  @@index([quizId])
  @@index([studentId])
}

model Result {
  id        String      @id @default(uuid())
  attemptId String      @unique
  studentId String
  quizId    String
  score     Float?
  passed    Boolean     @default(false)
  remarks   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student   User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quiz      Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([quizId])
}

model QuizAnswer {
  id               String       @id @default(uuid())
  attemptId        String
  questionId       String
  answerText       String?      @db.Text
  selectedOptionId String?
  isCorrect        Boolean?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model Material {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([courseId, order])
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String // MULTIPLE_CHOICE atau ESSAY
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
